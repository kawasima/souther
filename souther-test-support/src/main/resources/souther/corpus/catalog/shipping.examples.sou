// 出荷の行だけを持つ companion。`examples for` はモジュールを名指し、行は shipping.sou に書いた
// ものと合流する。同じモジュールなので import は要らない。値と fake は module のファイルの側に
// あり、ここは何が何に写るかだけを述べる。
examples for conformance.shipping

example 出荷する
    | "上限内で締切に余裕があれば台帳に書かれる" :
        (基準の指示) -> 書かれた
    | "上限ちょうどはまだ通る" :
        (出荷指示 { ...基準の指示, 重量 = Weight(30000) }) -> 書かれた
    | "上限をひとつ超えたら書かずに拒む" :
        (出荷指示 { ...基準の指示, 重量 = Weight(30001) }) -> 重量超過
    | "台帳が受け付けなければその答えがそのまま出る" :
        (台帳が拒む指示) -> 書けなかった
    | "速達も同じ規則で通る" :
        (出荷指示 { ...基準の指示, 区分 = 速達 }) -> 書かれた
    | "冷蔵も同じ規則で通る" :
        (出荷指示 { ...基準の指示, 区分 = 冷蔵 }) -> 書かれた
    | "最も軽い荷でも重量は重量" :
        (出荷指示 { ...基準の指示, 重量 = Weight(1) }) -> 書かれた
    | "一文字の送り状番号は番号として最も短い" :
        (出荷指示 { ...基準の指示, 番号 = 送り状番号("s") }) -> 書かれた
    | "締切が翌日なら急ぎで、午後の集荷なら出せない" :
        (出荷指示 { ...基準の指示, 締切 = DateTime("2026-08-11T09:00"),
            集荷時刻 = Time("14:00") })
        -> 重量超過
    | "締切が翌日でも午前の集荷なら出せる" :
        (出荷指示 { ...基準の指示, 締切 = DateTime("2026-08-11T09:00") }) -> 書かれた
    | "高い荷は台帳が同じ答えを返しても送料が上がる" :
        (出荷指示 { ...基準の指示, 品目 = 高い品目 }) -> 倍で書かれた

// 注入 behavior の行。実装は外から来るが、何を返すべきかはここで述べられる。
example 台帳へ書く
    | "受け付けた指示は書かれて返る" : (基準の指示) -> 書かれた
    | "受け付けられない指示はその旨が返る" : (台帳が拒む指示) -> 書けなかった
    | "速達も台帳の側では同じ扱い" :
        (出荷指示 { ...基準の指示, 区分 = 速達 }) -> 書かれた
    | "冷蔵も台帳の側では同じ扱い" :
        (出荷指示 { ...基準の指示, 区分 = 冷蔵 }) -> 書かれた
    | "一文字の送り状番号も台帳は受ける" :
        (出荷指示 { ...基準の指示, 番号 = 送り状番号("s") }) -> 書かれた
    | "最も軽い荷も台帳は受ける" :
        (出荷指示 { ...基準の指示, 重量 = Weight(1) }) -> 書かれた
