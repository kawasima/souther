<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>souther-cli</artifactId>
    <name>Souther CLI</name>

    <description>Bundles the compiler, runtime, and their dependencies into one really-executable
        jar so `souther` runs a .sou file without a Maven build.</description>

    <dependencies>
        <!-- The compiler pulls raoh + Jackson transitively (both compile-scope), and it declares
             souther-runtime as provided; this module adds it back at runtime so the uber jar is
             self-contained (the compiler's own published POM stays unchanged). -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-runtime</artifactId>
        </dependency>
        <!-- `souther lsp` serves the language server from this command line rather than from a
             second launcher, so an editor that has the compiler has the server. The plain jar, not
             the `all` one an editor downloads: that is this module's own dependencies again, and
             the uber jar this build writes bundles them once. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-lsp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test scope, and not part of what this jar bundles. `souther init` writes a build plugin
             version into a project, and a plugin drives a Souther over a numbered protocol; this is
             the artifact that states which number this Souther speaks, so it is what the pinned
             versions are held against. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-build-driver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The uber jar is `souther.jar` and the prepended launcher is `souther`. -->
        <finalName>souther</finalName>
        <resources>
            <!-- `souther init` writes a build file naming Raoh, JUnit and Surefire, and what it
                 names is what this build uses. Filtered rather than written out in the code, so the
                 two cannot drift apart. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>souther/cli/init/versions.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>souther/cli/init/versions.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- The `*IT` tests run the shipped artifacts themselves, after `package` has produced
                 them. What they cover is what only packaging decides: that the specification and
                 the doc sets are inside the artifact, that two jars' set registries were merged
                 rather than one replacing the other, and that the language server this module
                 depends on survived being shaded and reached the prepended launcher. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <systemPropertyVariables>
                        <souther.jar>${project.build.directory}/souther.jar</souther.jar>
                        <souther.binary>${project.build.directory}/souther</souther.binary>
                        <souther.version>${project.version}</souther.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- `souther japi` reads javadoc out of a library's sources. The shaded jar has its
                 dependencies inside it and nothing beside it, so without the sources bundled here
                 the javadoc it promises would never appear on the ordinary invocation. Only the
                 boundary libraries a Souther author actually meets are unpacked; the rest would
                 add tens of megabytes for classes nobody asks `japi` about. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-boundary-sources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>net.unit8.raoh</groupId>
                                    <artifactId>raoh</artifactId>
                                    <version>${raoh.version}</version>
                                    <classifier>sources</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>net.unit8.raoh</groupId>
                                    <artifactId>raoh-json</artifactId>
                                    <version>${raoh.version}</version>
                                    <classifier>sources</classifier>
                                </artifactItem>
                            </artifactItems>
                            <includes>**/*.java</includes>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/souther-sources</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Merge every dependency into one jar with Main-Class set. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Run on the class path, so module descriptors are noise
                                             (and several would collide). -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>souther.cli.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Every jar that ships documentation registers its set in a file
                                     at the same path. Without appending, one jar's registry would
                                     replace the other's and `souther doc` would lose a whole set. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/souther-docs/sets</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The launcher names an archive under this version's own name, so the version has to
                 reach the script. `@` rather than `${...}`, which the script itself uses for shell
                 parameter expansion. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>launcher</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/launcher</outputDirectory>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <delimiters>
                                <delimiter>@</delimiter>
                            </delimiters>
                            <resources>
                                <resource>
                                    <directory>src/main/launcher</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Prepend the launcher to the shaded jar so the output `target/souther` runs directly
                 (chmod already applied). What it passes to the JVM, and why, is written in the
                 script itself. -->
            <plugin>
                <groupId>org.skife.maven</groupId>
                <artifactId>really-executable-jar-maven-plugin</artifactId>
                <version>2.1.1</version>
                <configuration>
                    <programFile>souther</programFile>
                    <scriptFile>${project.build.directory}/launcher/souther</scriptFile>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>really-executable-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The really-executable jar is a distributable binary, not a library; keep it out of
             the Central bundle (distribute via GitHub Releases instead). -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <configuration>
                            <skipPublishing>true</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
